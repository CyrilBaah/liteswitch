# Copy this file to .env.local for local work, and set the same names in Vercel.
# Never commit .env.local.

# Flagsmith CLIENT-SIDE environment key (Flagsmith: Environment > Settings > Keys).
# Client keys are public by design: they ship in the browser bundle.
#   - main (production) deployment: the "Production" environment key
#   - sim deployment:                the "Development" environment key
#     (in Flagsmith, the environment named Development IS our Simulation environment)
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_KEY=

# Set to 1 ONLY on the sim deployment (the one using the Development key).
# It turns on the ?net=3g forced-connection override used by the simulation.
# On the production deployment, leave it empty: ?net= is then ignored.
NEXT_PUBLIC_SIM_MODE=

# --- Simulation script only (scripts/simulate.ts, run with `npm run simulate`) ---
# Vercel: Project > Settings > Deployment Protection > Protection Bypass for Automation.
# Only needed on your machine; never set it in Vercel's env vars.
VERCEL_AUTOMATION_BYPASS_SECRET=
# Optional overrides (defaults in scripts/simulate.ts):
# SIM_URL=https://liteswitch-git-sim-cyrilbaahs-projects.vercel.app/
# TARGET_PER_VARIANT=60
# MAX_VISITS=400
# CONCURRENCY=4
