# Copy this file to .env.local for local work, and set the same names in Vercel.
# Never commit .env.local.

# Flagsmith CLIENT-SIDE environment key (Flagsmith: Environment > Settings > Keys).
# Client keys are public by design: they ship in the browser bundle.
#   - main (production) deployment: the "Production" environment key
#   - sim deployment:                the "Simulation" environment key
NEXT_PUBLIC_FLAGSMITH_ENVIRONMENT_KEY=

# Set to 1 ONLY on the sim deployment (the one using the Simulation key).
# It turns on the ?net=3g forced-connection override used by the simulation.
# On the production deployment, leave it empty: ?net= is then ignored.
NEXT_PUBLIC_SIM_MODE=
